{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rule.md\"",
            "commandWindows": "Get-Content -Raw \"$env:CLAUDE_PLUGIN_ROOT\rule.md\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
